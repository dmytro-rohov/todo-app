# Build context allowlist: only what the Dockerfile copies.
*
!backend/package.json
!backend/package-lock.json
!backend/*.js
!backend/routes/
!backend/ai/
!backend/drizzle/
!backend/scripts/
!backend/vendor/
!frontend/package.json
!frontend/package-lock.json
!frontend/index.html
!frontend/privacy.html
!frontend/js/
!frontend/icons/
!frontend/manifest.webmanifest
!frontend/sw.js
!frontend/styles/*.scss
!frontend/vendor/
