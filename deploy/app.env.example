# Runtime configuration for the `app` service. Copy to app.env (chmod 600).
# Never commit the filled-in file.

NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Application role: data access only (SELECT/INSERT/UPDATE/DELETE), no DDL.
# Use sslmode=require when PostgreSQL is not on the same host/private network.
DATABASE_URL=postgres://tasks_app:CHANGE_ME@host.docker.internal:5432/tasks?sslmode=disable
PG_POOL_MAX=10
PG_STATEMENT_TIMEOUT_MS=10000

# Exact public origin; used for CSRF origin checks.
PUBLIC_ORIGIN=https://tasks.mytko.dev
# Host Caddy reaches the container through the Docker bridge gateway, so the
# app sees that gateway as its peer. Trust loopback plus ONLY that gateway /32:
#   docker network inspect mytko-tasks_default --format '{{(index .IPAM.Config 0).Gateway}}'
# Without it every client shares one rate-limit/lockout bucket (see PRODUCTION.md 3.5).
# Never trust all private subnets, true, or a hop count.
TRUST_PROXY=loopback

# Single-owner HTTP Basic auth. Generate the hash with:
#   printf '%s' "$PASSWORD" | docker run --rm -i "$APP_IMAGE" node backend/scripts/hash-password.js
AUTH_USERNAME=CHANGE_ME
AUTH_PASSWORD_HASH=scrypt:32768:8:1:CHANGE_ME:CHANGE_ME

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_FAIL_WINDOW_MS=900000
AUTH_FAIL_MAX=10
# Browser session length in hours (never extended). Optional, default 168.
SESSION_TTL_HOURS=168

# Google Calendars per space (optional; all three or none). An OAuth "Web application" client from Google Cloud
# with the redirect URI https://tasks.mytko.dev/auth/google/callback, and a key that encrypts the stored refresh
# tokens (openssl rand -base64 32; changing it means reconnecting the calendars).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# TASKS_SECRET_KEY=

# Booking form on mytko.dev (optional, needs the Google settings; docs/BOOKING.md). Slots come from the Praca calendar.
# BOOKING_ORIGINS=https://mytko.dev,https://www.mytko.dev
# BOOKING_HOURS=09:00-17:00
# BOOKING_DAYS=1-5
# BOOKING_SLOT_MINUTES=30

# Archive and clean-up (optional; 0 switches a step off). Done tasks go to the archive after RETENTION_ARCHIVE_DAYS;
# archived private tasks are deleted for good after RETENTION_DELETE_PRIVATE_DAYS, all others (Praca, clients)
# after RETENTION_DELETE_WORK_DAYS, with their notes, subtasks, timers and history.
RETENTION_ARCHIVE_DAYS=7
RETENTION_DELETE_PRIVATE_DAYS=7
RETENTION_DELETE_WORK_DAYS=90

# "Zaloguj kontem Mytko" (optional; all three or none). The secret is the one whose SHA-256 is registered for
# client "tasks" in Mytko Workflow's web-login/sso-clients.json. Generate: openssl rand -base64 36
# MYTKO_SSO_LOGIN is the Workflow panel login that becomes the owner here (Workflow may have other operators).
# MYTKO_SSO_ORIGIN=https://workflow.mytko.dev
# MYTKO_SSO_CLIENT_SECRET=
# MYTKO_SSO_LOGIN=

SHUTDOWN_TIMEOUT_MS=10000
