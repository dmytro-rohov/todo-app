-- Operator-run, once, as a PostgreSQL superuser/admin. Replace the passwords
-- with values from the secret store; never commit the filled-in file.
-- Not executed by the application or by any automation in this repository.

CREATE ROLE tasks_owner LOGIN PASSWORD 'CHANGE_ME_OWNER';
CREATE ROLE tasks_app LOGIN PASSWORD 'CHANGE_ME_APP';

CREATE DATABASE tasks OWNER tasks_owner;
REVOKE ALL ON DATABASE tasks FROM PUBLIC;
GRANT CONNECT ON DATABASE tasks TO tasks_app;

\connect tasks
-- PostgreSQL < 15 grants CREATE on public to everyone; remove it.
REVOKE CREATE ON SCHEMA public FROM PUBLIC;
ALTER SCHEMA public OWNER TO tasks_owner;
-- Table/sequence grants for tasks_app are applied by `migrate` (APP_DB_ROLE).
