# Configuration for the one-shot `migrate` service. Copy to migrate.env (chmod 600).
# Never commit the filled-in file.

NODE_ENV=production

# Schema owner role: owns the tables, runs DDL. Not available to the app.
MIGRATION_DATABASE_URL=postgres://tasks_owner:CHANGE_ME@host.docker.internal:5432/tasks?sslmode=disable

# Role that receives data-only privileges after migrating.
APP_DB_ROLE=tasks_app
