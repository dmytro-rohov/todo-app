# Local development only. Copy to backend/.env (gitignored).
# Production configuration lives in deploy/app.env and deploy/migrate.env.

NODE_ENV=development
PORT=3000

# Two roles, as in production: the app cannot change the schema.
DATABASE_URL=postgres://tasks_app:CHANGE_ME@localhost:5432/tasks_dev
MIGRATION_DATABASE_URL=postgres://tasks_owner:CHANGE_ME@localhost:5432/tasks_dev
APP_DB_ROLE=tasks_app

# Development may skip auth; production refuses to start with this set.
AUTH_DISABLED=true
