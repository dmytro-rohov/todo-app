# Copy to backend/.env (ignored by Git) and fill in local values.
# Never commit real credentials. Production values are managed by the operator.

# Required: PostgreSQL connection URL.
DATABASE_URL=postgres://todo_user:change-me@localhost:5432/todo_app

# Optional: bind address and port (defaults: 127.0.0.1 and 3000).
HOST=127.0.0.1
PORT=3000

# Optional: allowed CORS origin, only needed when the UI is served from
# another origin (e.g. http://127.0.0.1:5500). Leave empty for same-origin.
CORS_ORIGIN=

# Tests only: an isolated, disposable test database. Its name must contain
# "test". Integration tests are skipped when this is not set.
# TEST_DATABASE_URL=postgres://todo_user:change-me@localhost:5432/todo_app_test
