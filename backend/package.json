{
  "name": "todo-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Mytko Tasks API and static frontend server",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon --exec \"node --env-file-if-exists=.env\" server.js",
    "migrate": "node --env-file-if-exists=.env migrate.js",
    "hash-password": "node scripts/hash-password.js",
    "test": "node --test \"test/*.test.js\""
  },
  "engines": {
    "node": ">=24 <25"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  },
  "overrides": {
    "proxy-addr": "2.0.8",
    "body-parser": "2.4.0",
    "qs": "6.16.2",
    "brace-expansion": "5.0.12"
  }
}
