{
  "name": "todo-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Mytko Tasks API and static frontend server",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "migrate": "node --env-file-if-exists=.env migrate.js",
    "hash-password": "node scripts/hash-password.js",
    "test": "node --test \"test/*.test.js\"",
    "db:generate": "drizzle-kit generate"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "cors": "^2.8.6",
    "drizzle-orm": "0.45.4",
    "express": "^5.2.1",
    "pg": "^8.21.0"
  },
  "overrides": {
    "proxy-addr": "2.0.8",
    "body-parser": "2.4.0",
    "qs": "6.16.2",
    "brace-expansion": "5.0.12"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.11"
  }
}
